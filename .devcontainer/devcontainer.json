{
  "name": "adopt-core",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  // Pinned so that rebuilding the Codespace produces the same toolchain. A
  // floating base image is a build that changes underneath a green CI run.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },

  "containerEnv": {
    // Offline is the product's default posture, and the development
    // environment should not be the one place that quietly is not.
    "ADOPT_OFFLINE": "1"
  },

  "onCreateCommand": "bash .devcontainer/install-tools.sh",
  "postCreateCommand": "bash .devcontainer/postCreate.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/adopt-core/.venv/bin/python",
        "files.eol": "\n"
      }
    }
  },

  "remoteUser": "vscode"
}
