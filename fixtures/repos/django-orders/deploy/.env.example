# Example environment.
#
# The two credential values below are **canaries**, not placeholders: the
# planted-secret property suite asserts neither string reaches the store, an
# artifact, a log line or the run report. A value bland enough to be ignored
# would make that assertion pass by luck (`02` §10 C16, `01` N9).
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_LOG_LEVEL=INFO
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
REDIS_MAX_CONNECTIONS=50
ORDER_WEBHOOK_TIMEOUT=15
BILLING_API_TIMEOUT=30
WAREHOUSE_API_TIMEOUT=30
FEATURE_NEW_CHECKOUT=0
FEATURE_SPLIT_SHIPMENTS=1
DJANGO_SECRET_KEY=PLANTED-SECRET-DO-NOT-EMIT-a1b2c3d4
BILLING_API_TOKEN=sk-live-PLANTED-DO-NOT-EMIT-9f8e7d6c
