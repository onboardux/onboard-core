    <!-- Two credential canaries for the `01` N9 planted-secret suite. A Power
         Platform solution really does ship environment-variable *definitions*
         with default values, which is the most plausible place a credential
         travels in an export. Nothing in this build reads them today; the
         canaries are here so that the day something does, the property suite
         says so rather than a client's key reaching an artefact quietly. -->
    <environmentvariabledefinition schemaname="new_OrdersDbPassword">
      <displayname>Orders database password</displayname>
      <type>100000000</type>
      <defaultvalue>CANARY-do-not-emit-222222</defaultvalue>
